# Required for protected ingestion in production
INGEST_API_KEY=replace-me

# Wazuh levels 0-15. Reports are created at or above this level.
REPORT_MIN_SEVERITY=10

# Discord incoming webhook; leave blank to run without delivery.
DISCORD_WEBHOOK_URL=

# Optional OpenAI-compatible Chat Completions endpoint.
# When absent, reports are produced from the alert fields without an LLM.
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# Local persistence location
DATABASE_PATH=data/sidecar.db

